# TERRA Backend Environment Variables
APP_NAME="TERRA Agricultural Optimization API"
APP_VERSION="1.0.0"
DEBUG=False

# Database (defaults to SQLite; uncomment below for PostgreSQL)
DATABASE_URL="sqlite:///./terra.db"
# DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/terra"

# JWT Authentication
JWT_SECRET="terra-super-secure-jwt-secret-key-change-in-production-2026"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000", "http://localhost:8000"]
